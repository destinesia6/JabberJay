<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="JabberJay.SettingsPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Border BackgroundColor="Black"
            Padding="20"
            StrokeShape="RoundRectangle 15"
            StrokeThickness="0"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            MaximumWidthRequest="600">
        <VerticalStackLayout Spacing="15">
            <Label Text="Settings"
                   FontSize="Title"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="White"/>
            
            <!-- Replaced HorizontalStackLayout with a Grid to prevent clipping -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="ExportButton" 
                        Grid.Column="0" 
                        Text="Export" 
                        Clicked="OnExportClicked" 
                        BackgroundColor="MediumPurple" 
                        TextColor="White"
                        CornerRadius="10" />
                <Button x:Name="ImportButton" 
                        Grid.Column="1" 
                        Text="Import" 
                        Clicked="OnImportClicked" 
                        BackgroundColor="MediumPurple" 
                        TextColor="White"
                        CornerRadius="10" />
            </Grid>

            <Entry x:Name="PortInput"
                   Placeholder="Enter a port"
                   Keyboard="Numeric"
                   ClearButtonVisibility="WhileEditing"
                   TextColor="White"
                   PlaceholderColor="Gray"/>

            <Entry x:Name="IPInput"
                   Placeholder="Enter IP Address"
                   Keyboard="Text"
                   ClearButtonVisibility="WhileEditing"
                   TextColor="White"
                   PlaceholderColor="Gray">
                <Entry.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean">
                        <On Platform="Android" Value="True" />
                        <On Platform="Windows, iOS, MacCatalyst" Value="False" />
                    </OnPlatform>
                </Entry.IsVisible>
            </Entry>

            <Button Text="Submit"
                    Clicked="OnSubmitClicked"
                    BackgroundColor="MediumPurple"
                    TextColor="White"
                    CornerRadius="10"/>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>